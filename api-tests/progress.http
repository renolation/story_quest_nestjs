################################################################################
# INTEGRATION TEST - Complete Learning Workflow (1 test)
################################################################################

### ============================================================================
### I1. COMPLETE LEARNING WORKFLOW
### Complete a full level from start to finish
### ============================================================================

# Step 1: Start Level
# @name startLevelWorkflow
POST {{baseUrl}}/progress/levels/5/start
Authorization: Bearer {{studentToken}}

# Step 2: Get Questions for Level
GET {{baseUrl}}/levels/5?includeQuestions=true
Authorization: Bearer {{studentToken}}

# Step 3: Submit Answers (multiple questions)
POST {{baseUrl}}/progress/questions/20/answer
Authorization: Bearer {{studentToken}}
Content-Type: {{contentType}}

{
  "attemptId": {{startLevelWorkflow.response.body.id}},
  "questionId": 20,
  "selectedOptionId": 77,
  "isCorrect": true,
  "pointsEarned": 10,
  "timeSpentSeconds": 12
}

###
POST {{baseUrl}}/progress/questions/21/answer
Authorization: Bearer {{studentToken}}
Content-Type: {{contentType}}

{
  "attemptId": {{startLevelWorkflow.response.body.id}},
  "questionId": 21,
  "selectedOptionId": 81,
  "isCorrect": true,
  "pointsEarned": 10,
  "timeSpentSeconds": 15
}

###
POST {{baseUrl}}/progress/questions/22/answer
Authorization: Bearer {{studentToken}}
Content-Type: {{contentType}}

{
  "attemptId": {{startLevelWorkflow.response.body.id}},
  "questionId": 22,
  "answerText": "Hello",
  "isCorrect": true,
  "pointsEarned": 15,
  "timeSpentSeconds": 18
}

# Step 4: Complete Level
POST {{baseUrl}}/progress/levels/5/complete
Authorization: Bearer {{studentToken}}
Content-Type: {{contentType}}

{
  "attemptId": {{startLevelWorkflow.response.body.id}},
  "score": 88,
  "pointsEarned": 88,
  "isPassed": true,
  "timeSpentSeconds": 120
}

# Step 5: Check Updated Progress
GET {{baseUrl}}/progress/me
Authorization: Bearer {{studentToken}}

# Step 6: Check Unit Progress
GET {{baseUrl}}/progress/units/2
Authorization: Bearer {{studentToken}}

# Step 7: Check Chapter Progress
GET {{baseUrl}}/progress/chapters/1
Authorization: Bearer {{studentToken}}

################################################################################
# TEST SUMMARY
################################################################################

# Total Test Cases: 33
#
# Progress Overview (GET): 8 tests
# ├─ Get my progress, chapter progress, unit progress
# ├─ Authentication errors, invalid IDs
# └─ Not found scenarios
#
# Start Level: 6 tests
# ├─ Student role (success)
# ├─ Other roles (forbidden)
# ├─ Invalid level ID, no auth
# └─ Role-based access control
#
# Submit Answer: 10 tests
# ├─ Different question types (multiple choice, fill in blank, speech)
# ├─ Correct and incorrect answers
# ├─ Role-based access control
# ├─ Validation errors
# └─ Invalid IDs, wrong student attempts
#
# Complete Level: 8 tests
# ├─ Passed and failed attempts
# ├─ Perfect score scenarios
# ├─ Role-based access control
# ├─ Validation errors
# └─ Invalid IDs
#
# Integration Test: 1 comprehensive workflow
# └─ Full learning flow: Start → Answer → Complete → Check Progress
#
################################################################################
# TESTING INSTRUCTIONS
################################################################################

# 1. Start NestJS server: npm run start:dev
# 2. Login with STUDENT role using api-tests/auth.http
# 3. Copy student token to @studentToken variable
# 4. Run tests sequentially to verify:
#    ✓ Only STUDENT role can start levels, submit answers, complete levels
#    ✓ All roles can view progress (their own or assigned students)
#    ✓ Validation catches errors
#    ✓ Progress tracking calculates correctly
#    ✓ Attempts are properly linked to students
# 5. Check Swagger docs: http://localhost:3000/api/docs
#
# Expected Results:
# - Students can START, SUBMIT, and COMPLETE
# - Teachers/Centers/Agency CANNOT perform student actions (403)
# - All validation errors return 400
# - Authorization errors return 403
# - Not found errors return 404
# - Progress calculations are accurate
