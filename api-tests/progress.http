### Story Quest API - Comprehensive Progress Tracking Tests (Day 4)
### This file tests all progress tracking endpoints with role-based access control
### Prerequisites: Run auth.http first to get tokens for all roles

@baseUrl = http://localhost:3000/api/v1
@contentType = application/json

### TOKENS - Update these after logging in with auth.http
@studentToken = your_student_token_here
@teacherToken = your_teacher_token_here
@centerToken = your_center_token_here
@agencyToken = your_agency_token_here

### Test IDs (update after creating resources and attempts)
@levelId1 = 1
@levelId2 = 2
@questionId1 = 1
@questionId2 = 2
@attemptId = 1

################################################################################
# PROGRESS OVERVIEW - GET ENDPOINTS (8 test cases)
################################################################################

### ============================================================================
### P1. GET MY PROGRESS - Student
### Role: STUDENT | Expected: 200 OK
### ============================================================================
GET {{baseUrl}}/progress/me
Authorization: Bearer {{studentToken}}

### ============================================================================
### P2. GET CHAPTER PROGRESS - Student
### Role: STUDENT | Expected: 200 OK or 404 if no progress
### ============================================================================
GET {{baseUrl}}/progress/chapters/{{chapterId1}}
Authorization: Bearer {{studentToken}}

### ============================================================================
### P3. GET UNIT PROGRESS - Student
### Role: STUDENT | Expected: 200 OK or 404 if no progress
### ============================================================================
GET {{baseUrl}}/progress/units/{{unitId1}}
Authorization: Bearer {{studentToken}}

### ============================================================================
### P4. GET PROGRESS - NO AUTHENTICATION
### Expected: 401 Unauthorized
### ============================================================================
GET {{baseUrl}}/progress/me

### ============================================================================
### P5. GET PROGRESS - INVALID TOKEN
### Expected: 401 Unauthorized
### ============================================================================
GET {{baseUrl}}/progress/me
Authorization: Bearer invalid_token_here

### ============================================================================
### P6. GET CHAPTER PROGRESS - Invalid Chapter ID
### Role: STUDENT | Expected: 404 Not Found or null
### ============================================================================
GET {{baseUrl}}/progress/chapters/99999
Authorization: Bearer {{studentToken}}

### ============================================================================
### P7. GET UNIT PROGRESS - Invalid Unit ID
### Role: STUDENT | Expected: 404 Not Found or null
### ============================================================================
GET {{baseUrl}}/progress/units/99999
Authorization: Bearer {{studentToken}}

### ============================================================================
### P8. GET STUDENT NOT FOUND
### Role: STUDENT | Expected: 404 Not Found (if student deleted)
### ============================================================================
GET {{baseUrl}}/progress/me
Authorization: Bearer {{studentToken}}

################################################################################
# START LEVEL - POST ENDPOINTS (6 test cases)
################################################################################

### ============================================================================
### S1. START LEVEL - Student Role
### Role: STUDENT | Expected: 201 Created
### ============================================================================
# @name startLevel
POST {{baseUrl}}/progress/levels/{{levelId1}}/start
Authorization: Bearer {{studentToken}}

### ============================================================================
### S2. START LEVEL - Teacher Role (should fail)
### Role: TEACHER | Expected: 403 Forbidden
### ============================================================================
POST {{baseUrl}}/progress/levels/{{levelId1}}/start
Authorization: Bearer {{teacherToken}}

### ============================================================================
### S3. START LEVEL - Center Role (should fail)
### Role: CENTER | Expected: 403 Forbidden
### ============================================================================
POST {{baseUrl}}/progress/levels/{{levelId1}}/start
Authorization: Bearer {{centerToken}}

### ============================================================================
### S4. START LEVEL - Agency Role (should fail)
### Role: AGENCY | Expected: 403 Forbidden
### ============================================================================
POST {{baseUrl}}/progress/levels/{{levelId1}}/start
Authorization: Bearer {{agencyToken}}

### ============================================================================
### S5. START LEVEL - Invalid Level ID
### Role: STUDENT | Expected: 404 Not Found
### ============================================================================
POST {{baseUrl}}/progress/levels/99999/start
Authorization: Bearer {{studentToken}}

### ============================================================================
### S6. START LEVEL - No Authentication
### Expected: 401 Unauthorized
### ============================================================================
POST {{baseUrl}}/progress/levels/{{levelId1}}/start

################################################################################
# SUBMIT ANSWER - POST ENDPOINTS (10 test cases)
################################################################################

### ============================================================================
### A1. SUBMIT ANSWER - Student Role (Correct Answer)
### Role: STUDENT | Expected: 201 Created
### ============================================================================
POST {{baseUrl}}/progress/questions/{{questionId1}}/answer
Authorization: Bearer {{studentToken}}
Content-Type: {{contentType}}

{
  "attemptId": {{attemptId}},
  "questionId": {{questionId1}},
  "selectedOptionId": 1,
  "isCorrect": true,
  "pointsEarned": 10,
  "timeSpentSeconds": 15
}

### ============================================================================
### A2. SUBMIT ANSWER - Student Role (Incorrect Answer)
### Role: STUDENT | Expected: 201 Created
### ============================================================================
POST {{baseUrl}}/progress/questions/{{questionId2}}/answer
Authorization: Bearer {{studentToken}}
Content-Type: {{contentType}}

{
  "attemptId": {{attemptId}},
  "questionId": {{questionId2}},
  "selectedOptionId": 6,
  "isCorrect": false,
  "pointsEarned": 0,
  "timeSpentSeconds": 20
}

### ============================================================================
### A3. SUBMIT ANSWER - Fill in Blank Question
### Role: STUDENT | Expected: 201 Created
### ============================================================================
POST {{baseUrl}}/progress/questions/3/answer
Authorization: Bearer {{studentToken}}
Content-Type: {{contentType}}

{
  "attemptId": {{attemptId}},
  "questionId": 3,
  "answerText": "Hello",
  "isCorrect": true,
  "pointsEarned": 15,
  "timeSpentSeconds": 25
}

### ============================================================================
### A4. SUBMIT ANSWER - Speech Question
### Role: STUDENT | Expected: 201 Created
### ============================================================================
POST {{baseUrl}}/progress/questions/4/answer
Authorization: Bearer {{studentToken}}
Content-Type: {{contentType}}

{
  "attemptId": {{attemptId}},
  "questionId": 4,
  "answerAudioUrl": "https://storage.example.com/student-audio/attempt1-q4.mp3",
  "isCorrect": true,
  "pointsEarned": 20,
  "timeSpentSeconds": 30
}

### ============================================================================
### A5. SUBMIT ANSWER - Teacher Role (should fail)
### Role: TEACHER | Expected: 403 Forbidden
### ============================================================================
POST {{baseUrl}}/progress/questions/{{questionId1}}/answer
Authorization: Bearer {{teacherToken}}
Content-Type: {{contentType}}

{
  "attemptId": {{attemptId}},
  "questionId": {{questionId1}},
  "selectedOptionId": 1,
  "isCorrect": true,
  "pointsEarned": 10
}

### ============================================================================
### A6. SUBMIT ANSWER - Invalid Attempt ID
### Role: STUDENT | Expected: 404 Not Found
### ============================================================================
POST {{baseUrl}}/progress/questions/{{questionId1}}/answer
Authorization: Bearer {{studentToken}}
Content-Type: {{contentType}}

{
  "attemptId": 99999,
  "questionId": {{questionId1}},
  "selectedOptionId": 1,
  "isCorrect": true,
  "pointsEarned": 10
}

### ============================================================================
### A7. SUBMIT ANSWER - Invalid Question ID
### Role: STUDENT | Expected: 404 Not Found
### ============================================================================
POST {{baseUrl}}/progress/questions/99999/answer
Authorization: Bearer {{studentToken}}
Content-Type: {{contentType}}

{
  "attemptId": {{attemptId}},
  "questionId": 99999,
  "selectedOptionId": 1,
  "isCorrect": true,
  "pointsEarned": 10
}

### ============================================================================
### A8. SUBMIT ANSWER - Validation Error (missing required fields)
### Role: STUDENT | Expected: 400 Bad Request
### ============================================================================
POST {{baseUrl}}/progress/questions/{{questionId1}}/answer
Authorization: Bearer {{studentToken}}
Content-Type: {{contentType}}

{
  "attemptId": {{attemptId}},
  "questionId": {{questionId1}}
}

### ============================================================================
### A9. SUBMIT ANSWER - Wrong Student's Attempt
### Role: STUDENT | Expected: 404 Not Found (attempt doesn't belong to student)
### ============================================================================
POST {{baseUrl}}/progress/questions/{{questionId1}}/answer
Authorization: Bearer {{studentToken}}
Content-Type: {{contentType}}

{
  "attemptId": 2,
  "questionId": {{questionId1}},
  "selectedOptionId": 1,
  "isCorrect": true,
  "pointsEarned": 10
}

### ============================================================================
### A10. SUBMIT ANSWER - No Authentication
### Expected: 401 Unauthorized
### ============================================================================
POST {{baseUrl}}/progress/questions/{{questionId1}}/answer
Content-Type: {{contentType}}

{
  "attemptId": {{attemptId}},
  "questionId": {{questionId1}},
  "selectedOptionId": 1,
  "isCorrect": true,
  "pointsEarned": 10
}

