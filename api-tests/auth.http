### Story Quest API - Authentication Tests
### Base URL
@baseUrl = http://localhost:3000/api/v1
@studentToken =
@teacherToken =
@agencyToken =

###############################################
### HEALTH CHECK
###############################################

### Health Check
GET {{baseUrl}}/auth/health

###############################################
### STUDENT REGISTRATION & LOGIN
###############################################

### Register New Student
# @name registerStudent
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "email": "newstudent@test.com",
  "username": "newstudent123",
  "password": "Password123",
  "fullName": "New Test Student",
  "role": "student"
}

### Login as Student (from seeded data)
# @name loginStudent
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "identifier": "student1@test.com",
  "password": "Password123"
}

###############################################
### AUTHENTICATED USER ENDPOINTS
###############################################

### Get Current User Profile
GET {{baseUrl}}/auth/me
Authorization: Bearer {{studentToken}}

### Get My Profile (Users endpoint)
GET {{baseUrl}}/users/me
Authorization: Bearer {{studentToken}}

### Update My Profile
PATCH {{baseUrl}}/users/me
Authorization: Bearer {{studentToken}}
Content-Type: application/json

{
  "fullName": "Updated Student Name",
  "avatarUrl": "https://example.com/new-avatar.jpg"
}

### Change Password
PATCH {{baseUrl}}/auth/change-password
Authorization: Bearer {{studentToken}}
Content-Type: application/json

{
  "currentPassword": "Password123",
  "newPassword": "NewPassword456",
  "confirmPassword": "NewPassword456"
}

###############################################
### TEACHER LOGIN & ENDPOINTS
###############################################

### Login as Teacher
# @name loginTeacher
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "identifier": "teacher1@storyquest.com",
  "password": "Password123"
}

### Create New Student (Teacher role)
POST {{baseUrl}}/auth/users
Authorization: Bearer {{teacherToken}}
Content-Type: application/json

{
  "email": "teacher-created-student@test.com",
  "username": "teacherstudent1",
  "password": "Password123",
  "fullName": "Teacher Created Student",
  "role": "student"
}

### Get User by ID (Teacher can view student details)
GET {{baseUrl}}/users/21
Authorization: Bearer {{teacherToken}}

###############################################
### CENTER ADMIN ENDPOINTS
###############################################

### Login as Center Admin
# @name loginCenter
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "identifier": "center1@storyquest.com",
  "password": "Password123"
}

### List All Users (Center admin)
GET {{baseUrl}}/users?page=1&limit=10
Authorization: Bearer {{agencyToken}}

### Filter Users by Role
GET {{baseUrl}}/users?role=student&page=1&limit=10
Authorization: Bearer {{agencyToken}}

### Create Teacher (Center can create teachers)
POST {{baseUrl}}/auth/users
Authorization: Bearer {{agencyToken}}
Content-Type: application/json

{
  "email": "newteacher@storyquest.com",
  "username": "newteacher1",
  "password": "Password123",
  "fullName": "New Teacher Created by Center",
  "role": "teacher"
}

###############################################
### AGENCY (SUPER ADMIN) ENDPOINTS
###############################################

### Login as Agency
# @name loginAgency
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "identifier": "agency@storyquest.com",
  "password": "Password123"
}

### List All Users (Agency)
GET {{baseUrl}}/users
Authorization: Bearer {{agencyToken}}

### Create Center Admin (Agency can create centers)
POST {{baseUrl}}/auth/users
Authorization: Bearer {{agencyToken}}
Content-Type: application/json

{
  "email": "newcenter@storyquest.com",
  "username": "newcenter1",
  "password": "Password123",
  "fullName": "New Center Admin",
  "role": "center"
}

###############################################
### ERROR HANDLING TESTS
###############################################

### Test - Invalid Credentials
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "identifier": "student1@test.com",
  "password": "WrongPassword"
}

### Test - Duplicate Email
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "email": "student1@test.com",
  "username": "duplicate123",
  "password": "Password123",
  "fullName": "Duplicate Email Test",
  "role": "student"
}

### Test - No Token (Unauthorized)
GET {{baseUrl}}/auth/me

### Test - Invalid Token
GET {{baseUrl}}/auth/me
Authorization: Bearer invalid_token_here
