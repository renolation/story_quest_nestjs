### Story Quest API - Comprehensive Levels & Questions Testing (Day 3)
### This file tests all enhanced endpoints with role-based access control
### Prerequisites: Run auth.http first to get tokens for all roles

@baseUrl = http://localhost:3000/api/v1
@contentType = application/json

### TOKENS - Update these after logging in with auth.http
@agencyToken = your_agency_token_here
@centerToken = your_center_token_here
@teacherToken = your_teacher_token_here
@studentToken = your_student_token_here

### Test IDs (update after creating resources)
@unitId1 = 1
@levelId1 = 1
@levelId2 = 2
@levelId3 = 3
@questionId1 = 1
@questionId2 = 2
@questionId3 = 3

################################################################################
# LEVELS API - COMPREHENSIVE TESTING (18 test cases)
################################################################################

### ============================================================================
### L1. GET ALL LEVELS (Student view with progress)
### Role: STUDENT | Expected: 200 OK
### ============================================================================
GET {{baseUrl}}/levels
Authorization: Bearer {{studentToken}}

### ============================================================================
### L2. GET LEVELS BY UNIT ID (filter by unit)
### Role: STUDENT | Expected: 200 OK
### ============================================================================
GET {{baseUrl}}/levels?unitId={{unitId1}}
Authorization: Bearer {{studentToken}}

### ============================================================================
### L3. GET LEVELS WITH QUESTIONS (include nested questions)
### Role: STUDENT | Expected: 200 OK
### ============================================================================
GET {{baseUrl}}/levels?unitId={{unitId1}}&includeQuestions=true
Authorization: Bearer {{studentToken}}

### ============================================================================
### L4. GET SINGLE LEVEL BY ID
### Role: STUDENT | Expected: 200 OK
### ============================================================================
GET {{baseUrl}}/levels/{{levelId1}}
Authorization: Bearer {{studentToken}}

### ============================================================================
### L5. GET SINGLE LEVEL WITH QUESTIONS
### Role: STUDENT | Expected: 200 OK
### ============================================================================
GET {{baseUrl}}/levels/{{levelId1}}?includeQuestions=true
Authorization: Bearer {{studentToken}}

### ============================================================================
### L6. CREATE LEVEL - TEACHER ROLE
### Role: TEACHER | Expected: 201 Created
### ============================================================================
POST {{baseUrl}}/levels
Authorization: Bearer {{teacherToken}}
Content-Type: {{contentType}}

{
  "unitId": {{unitId1}},
  "title": "Practice Hello - Easy",
  "description": "Practice saying hello in different situations",
  "orderIndex": 0,
  "timeLimitSeconds": 300,
  "passingScore": 70,
  "totalPoints": 100,
  "isActive": true
}

### ============================================================================
### L7. CREATE LEVEL - CENTER ROLE
### Role: CENTER | Expected: 201 Created
### ============================================================================
POST {{baseUrl}}/levels
Authorization: Bearer {{centerToken}}
Content-Type: {{contentType}}

{
  "unitId": {{unitId1}},
  "title": "Practice Hello - Medium",
  "description": "Intermediate hello practice with more contexts",
  "orderIndex": 1,
  "timeLimitSeconds": 450,
  "passingScore": 75,
  "totalPoints": 150,
  "isActive": true
}

### ============================================================================
### L8. CREATE LEVEL - AGENCY ROLE
### Role: AGENCY | Expected: 201 Created
### ============================================================================
POST {{baseUrl}}/levels
Authorization: Bearer {{agencyToken}}
Content-Type: {{contentType}}

{
  "unitId": {{unitId1}},
  "title": "Practice Hello - Hard",
  "description": "Advanced hello practice with complex scenarios",
  "orderIndex": 2,
  "timeLimitSeconds": 600,
  "passingScore": 80,
  "totalPoints": 200,
  "isActive": true
}

### ============================================================================
### L9. CREATE LEVEL - VALIDATION ERROR (invalid passing score)
### Role: TEACHER | Expected: 400 Bad Request
### ============================================================================
POST {{baseUrl}}/levels
Authorization: Bearer {{teacherToken}}
Content-Type: {{contentType}}

{
  "unitId": {{unitId1}},
  "title": "Invalid Level",
  "orderIndex": 0,
  "passingScore": 150,
  "totalPoints": 100
}

### ============================================================================
### L10. CREATE LEVEL - INVALID UNIT ID
### Role: TEACHER | Expected: 404 Not Found
### ============================================================================
POST {{baseUrl}}/levels
Authorization: Bearer {{teacherToken}}
Content-Type: {{contentType}}

{
  "unitId": 99999,
  "title": "Level with Invalid Unit",
  "orderIndex": 0,
  "passingScore": 70,
  "totalPoints": 100
}

### ============================================================================
### L11. CREATE LEVEL - UNAUTHORIZED (Student role)
### Role: STUDENT | Expected: 403 Forbidden
### ============================================================================
POST {{baseUrl}}/levels
Authorization: Bearer {{studentToken}}
Content-Type: {{contentType}}

{
  "unitId": {{unitId1}},
  "title": "Should Fail - Student Cannot Create",
  "orderIndex": 10
}

