### L12. UPDATE LEVEL - TEACHER ROLE
### Role: TEACHER | Expected: 200 OK
### ============================================================================
PATCH {{baseUrl}}/levels/{{levelId1}}
Authorization: Bearer {{teacherToken}}
Content-Type: {{contentType}}

{
  "title": "Practice Hello - Easy (Updated)",
  "timeLimitSeconds": 350
}

### ============================================================================
### L13. UPDATE LEVEL - CENTER ROLE
### Role: CENTER | Expected: 200 OK
### ============================================================================
PATCH {{baseUrl}}/levels/{{levelId1}}
Authorization: Bearer {{centerToken}}
Content-Type: {{contentType}}

{
  "passingScore": 75,
  "isActive": true
}

### ============================================================================
### L14. UPDATE LEVEL - AGENCY ROLE
### Role: AGENCY | Expected: 200 OK
### ============================================================================
PATCH {{baseUrl}}/levels/{{levelId2}}
Authorization: Bearer {{agencyToken}}
Content-Type: {{contentType}}

{
  "totalPoints": 180
}

### ============================================================================
### L15. UPDATE LEVEL - NOT FOUND
### Role: TEACHER | Expected: 404 Not Found
### ============================================================================
PATCH {{baseUrl}}/levels/99999
Authorization: Bearer {{teacherToken}}
Content-Type: {{contentType}}

{
  "title": "Non-existent Level"
}

### ============================================================================
### L16. DELETE LEVEL - AGENCY ROLE (only allowed role)
### Role: AGENCY | Expected: 204 No Content
### ============================================================================
DELETE {{baseUrl}}/levels/{{levelId3}}
Authorization: Bearer {{agencyToken}}

### ============================================================================
### L17. DELETE LEVEL - FORBIDDEN (Teacher role)
### Role: TEACHER | Expected: 403 Forbidden
### ============================================================================
DELETE {{baseUrl}}/levels/{{levelId1}}
Authorization: Bearer {{teacherToken}}

### ============================================================================
### L18. DELETE LEVEL - FORBIDDEN (Center role)
### Role: CENTER | Expected: 403 Forbidden
### ============================================================================
DELETE {{baseUrl}}/levels/{{levelId1}}
Authorization: Bearer {{centerToken}}

################################################################################
# QUESTIONS API - COMPREHENSIVE TESTING (18 test cases)
################################################################################

### ============================================================================
### Q1. GET ALL QUESTIONS (all questions across levels)
### Role: STUDENT | Expected: 200 OK
### ============================================================================
GET {{baseUrl}}/questions
Authorization: Bearer {{studentToken}}

### ============================================================================
### Q2. GET QUESTIONS BY LEVEL ID (filter by level)
### Role: STUDENT | Expected: 200 OK
### ============================================================================
GET {{baseUrl}}/questions?levelId={{levelId1}}
Authorization: Bearer {{studentToken}}

### ============================================================================
### Q3. GET SINGLE QUESTION BY ID (with answer options)
### Role: STUDENT | Expected: 200 OK
### ============================================================================
GET {{baseUrl}}/questions/{{questionId1}}
Authorization: Bearer {{studentToken}}

### ============================================================================
### Q4. CREATE QUESTION - SELECT RIGHT ANSWER TYPE (Teacher role)
### Role: TEACHER | Expected: 201 Created
### ============================================================================
POST {{baseUrl}}/questions
Authorization: Bearer {{teacherToken}}
Content-Type: {{contentType}}

{
  "levelId": {{levelId1}},
  "questionType": "select_right_answer",
  "questionText": "What is the correct way to say hello?",
  "questionAudioUrl": "https://storage.example.com/audio/q1.mp3",
  "orderIndex": 0,
  "points": 10,
  "hint": "Think about friendly greetings",
  "explanation": "Hello is the most common greeting in English",
  "isActive": true,
  "answerOptions": [
    {
      "optionText": "Hello",
      "isCorrect": true,
      "orderIndex": 0
    },
    {
      "optionText": "Goodbye",
      "isCorrect": false,
      "orderIndex": 1
    },
    {
      "optionText": "Thank you",
      "isCorrect": false,
      "orderIndex": 2
    },
    {
      "optionText": "Sorry",
      "isCorrect": false,
      "orderIndex": 3
    }
  ]
}

### ============================================================================
### Q5. CREATE QUESTION - FILL IN BLANK TYPE (Center role)
### Role: CENTER | Expected: 201 Created
### ============================================================================
POST {{baseUrl}}/questions
Authorization: Bearer {{centerToken}}
Content-Type: {{contentType}}

{
  "levelId": {{levelId1}},
  "questionType": "fill_in_blank",
  "questionText": "Complete the sentence: '_____, how are you?'",
  "questionAudioUrl": "https://storage.example.com/audio/q2.mp3",
  "orderIndex": 1,
  "points": 15,
  "hint": "Fill in the greeting word",
  "isActive": true,
  "answerOptions": [
    {
      "optionText": "Hello",
      "isCorrect": true,
      "orderIndex": 0
    },
    {
      "optionText": "Hi",
      "isCorrect": true,
      "orderIndex": 1
    }
  ]
}

### ============================================================================
### Q6. CREATE QUESTION - SORT WORDS TYPE (Agency role)
